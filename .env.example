# VAT Chain Auditor configuration
VAT_DEVICE=auto
ALLOW_MODEL_DOWNLOAD=true
LOAD_OPTIONAL_GEMMA=false

QWEN_MODEL_ID=Qwen/Qwen3-8B
DEEPSEEK_MODEL_ID=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B
GEMMA_MODEL_ID=google/gemma-3-4b-it
EMBEDDING_MODEL_ID=BAAI/bge-m3
RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
DEBERTA_MODEL_ID=microsoft/deberta-v3-base
LAYOUTLM_MODEL_ID=microsoft/layoutlmv3-base

POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/vat_chain_auditor
VECTOR_TABLE=vat_legal_documents
RAG_TOP_K=12
RERANK_TOP_K=5

MAX_NEW_TOKENS=700
TEMPERATURE=0.1
LOG_LEVEL=INFO

LIGHTGBM_MODEL_PATH=artifacts/lightgbm.txt
CALIBRATION_MODEL_PATH=artifacts/isotonic.pkl
